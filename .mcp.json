{
    "mcpServers": {
        "drawio": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@drawio/mcp"
            ],
            "env": {}
        },
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "@playwright/mcp@latest"
            ],
            "env": {}
        },
        "terraform": {
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "hashicorp/terraform-mcp-server"
            ]
        }
    }
}
