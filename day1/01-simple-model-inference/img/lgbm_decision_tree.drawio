          <mxGeometry x="280" y="370" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="leaf_3" value="Leaf: 0.000" style="ellipse;whiteSpace=wrap;html=0;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="370" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n2_rr" value="Column_3 ≤ 0.000&#xa;gain: 0.000&#xa;count: 53" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="800" y="370" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Level 3 leaves -->
        <mxCell id="leaf_4" value="Leaf: -0.067" style="ellipse;whiteSpace=wrap;html=0;fillColor=#D1FAE5;strokeColor=#059669;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="490" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="leaf_5" value="Leaf: -0.067" style="ellipse;whiteSpace=wrap;html=0;fillColor=#D1FAE5;strokeColor=#059669;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="490" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="yes" style="rounded=1;strokeColor=#059669;strokeWidth=2;fontStyle=1;fontSize=10;fontColor=#059669;" edge="1" source="root" target="n1_left" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="no" style="rounded=1;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;fontSize=10;fontColor=#DC2626;" edge="1" source="root" target="n1_right" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="yes" style="rounded=1;strokeColor=#059669;strokeWidth=2;fontStyle=1;fontSize=10;fontColor=#059669;" edge="1" source="n1_left" target="leaf_1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="no" style="rounded=1;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;fontSize=10;fontColor=#DC2626;" edge="1" source="n1_left" target="leaf_2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="yes" style="rounded=1;strokeColor=#059669;strokeWidth=2;fontStyle=1;fontSize=10;fontColor=#059669;" edge="1" source="n1_right" target="leaf_3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="no" style="rounded=1;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;fontSize=10;fontColor=#DC2626;" edge="1" source="n1_right" target="n2_rr" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="yes" style="rounded=1;strokeColor=#059669;strokeWidth=2;fontStyle=1;fontSize=10;fontColor=#059669;" edge="1" source="n2_rr" target="leaf_4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="no" style="rounded=1;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;fontSize=10;fontColor=#DC2626;" edge="1" source="n2_rr" target="leaf_5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Legend -->
        <mxCell id="legend_box" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F9FAFB;strokeColor=#E5E7EB;arcSize=10;" vertex="1" parent="1">
