        </mxCell>
        <mxCell id="legend_split_t" value="分岐ノード（特徴量 ≤ 閾値で分岐）" style="text;html=0;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="605" width="250" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="legend_leaf" value="" style="ellipse;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="50" y="635" width="30" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="legend_leaf_t" value="葉ノード（予測値を出力）" style="text;html=0;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="635" width="250" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="legend_yes_t" value="yes = 条件を満たす / no = 満たさない" style="text;html=0;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="50" y="665" width="300" height="20" as="geometry"/>
        </mxCell>

        <!-- Ensemble info -->
        <mxCell id="ensemble_box" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FEF3C7;strokeColor=#D97706;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="570" width="500" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ens_title" value="アンサンブル（勾配ブースティング）" style="text;html=0;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="470" y="575" width="300" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="ens_text" value="Tree₁ + Tree₂ + ... + Tree₁₂₀ → 最終予測&#xa;&#xa;各ラウンドで前のラウンドの「残差」を学習する新しい木を追加。&#xa;120本 = 3クラス × 40ラウンド&#xa;各木の予測値を合算して最終的な確率を算出。" style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="470" y="600" width="460" height="80" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
