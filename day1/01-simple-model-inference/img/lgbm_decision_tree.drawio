<mxfile>
  <diagram name="LightGBM Decision Tree" id="lgbm-tree">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="LightGBM 決定木（勾配ブースティング）" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="450" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="120本の決定木（3クラス × 40ラウンド）のアンサンブル" style="text;html=0;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="350" y="55" width="450" height="25" as="geometry"/>
        </mxCell>

        <!-- Single Tree Example -->
