          <mxGeometry x="350" y="90" width="450" height="30" as="geometry"/>
        </mxCell>

        <!-- Root node -->
        <mxCell id="root" value="Column_3 ≤ 0.465&#xa;gain: 0.328&#xa;count: 90" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DBEAFE;strokeColor=#2563EB;fontStyle=1;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="490" y="130" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Level 1 Left -->
        <mxCell id="n1_left" value="Column_2 ≤ 0.567&#xa;gain: 0.160&#xa;count: 60" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="250" y="240" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Level 1 Right -->
        <mxCell id="n1_right" value="Column_3 ≤ 0.333&#xa;gain: 0.000&#xa;count: 57" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="640" y="240" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Level 2 leaves and nodes -->
        <mxCell id="leaf_1" value="Leaf: 0.029" style="ellipse;whiteSpace=wrap;html=0;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=10;" vertex="1" parent="1">
