        <!-- WER: 計算式 -->
        <mxCell id="wer-formula-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="90" width="280" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="wer-formula" value="&lt;div style='text-align:left;font-family:Helvetica;'&gt;&lt;b style='font-size:13px;'&gt;WER の計算&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;S (置換) = 2&lt;br/&gt;D (削除) = 0&lt;br/&gt;I (挿入) = 0&lt;br/&gt;N (正解単語数) = 6&lt;br/&gt;&lt;br/&gt;&lt;b style='font-size:14px; color:#9673A6;'&gt;WER = (2+0+0) / 6&lt;br/&gt;= 33.3%&lt;/b&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="95" width="260" height="160" as="geometry"/>
        </mxCell>

