        <mxCell id="sent_metric" value="F1（バランス型）" style="text;html=0;fontSize=12;fontStyle=1;align=center;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="560" y="424" width="200" height="20" as="geometry"/>
