        <mxCell id="sent_reason" value="どちらの誤りも同程度に重要" style="text;html=0;fontSize=10;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="560" y="448" width="200" height="28" as="geometry"/>
