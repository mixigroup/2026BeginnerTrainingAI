        </mxCell>
        <mxCell id="spam_metric" value="Precision 重視" style="text;html=0;fontSize=12;fontStyle=1;align=center;fontColor=#7B3FA0;" vertex="1" parent="1">
          <mxGeometry x="60" y="424" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="spam_reason" value="正常メールを誤ってスパムにしたくない" style="text;html=0;fontSize=10;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="448" width="200" height="28" as="geometry"/>
        </mxCell>

        <!-- Medical -->
        <mxCell id="med_box" value="" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="310" y="400" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="med_title" value="医療診断" style="text;html=0;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="310" y="404" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="med_metric" value="Recall 重視" style="text;html=0;fontSize=12;fontStyle=1;align=center;fontColor=#2E6CA4;" vertex="1" parent="1">
          <mxGeometry x="310" y="424" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="med_reason" value="病気の見逃しを絶対に防ぎたい" style="text;html=0;fontSize=10;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="310" y="448" width="200" height="28" as="geometry"/>
        </mxCell>

        <!-- Sentiment -->
        <mxCell id="sent_box" value="" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#CCCCCC;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="sent_title" value="感情分析" style="text;html=0;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="404" width="200" height="20" as="geometry"/>
