<mxfile>
  <diagram name="IoU Explanation" id="iou">
    <mxGraphModel adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="IoU（Intersection over Union）の直感" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="100" y="10" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- IoU = 0.0 -->
        <mxCell id="label0" value="IoU = 0.0" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="0" y="50" width="150" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="gt0" value="" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="10" y="80" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="pred0" value="" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="desc0" value="重なりなし" style="text;html=1;fontSize=11;align=center;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="0" y="150" width="150" height="20" as="geometry"/>
        </mxCell>

        <!-- IoU = 0.25 -->
        <mxCell id="label25" value="IoU ≈ 0.25" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="170" y="50" width="150" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="gt25" value="" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="185" y="80" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="pred25" value="" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="220" y="90" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="inter25" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;opacity=70;" vertex="1" parent="1">
          <mxGeometry x="220" y="90" width="25" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="desc25" value="少し重なり" style="text;html=1;fontSize=11;align=center;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="170" y="160" width="150" height="20" as="geometry"/>
        </mxCell>

        <!-- IoU = 0.5 (AP50) -->
        <mxCell id="label50" value="&lt;font color=&quot;#CC6600&quot;&gt;IoU = 0.5&lt;/font&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="340" y="50" width="150" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="gt50" value="" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="350" y="75" width="70" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pred50" value="" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="380" y="85" width="70" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="inter50" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;opacity=70;" vertex="1" parent="1">
          <mxGeometry x="380" y="85" width="40" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="desc50" value="&lt;font color=&quot;#CC6600&quot;&gt;&lt;b&gt;AP50 の基準&lt;/b&gt;&lt;/font&gt;" style="text;html=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="340" y="160" width="150" height="20" as="geometry"/>
        </mxCell>

        <!-- IoU = 0.75 (AP75) -->
        <mxCell id="label75" value="&lt;font color=&quot;#CC6600&quot;&gt;IoU = 0.75&lt;/font&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="510" y="50" width="150" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="gt75" value="" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="530" y="75" width="70" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pred75" value="" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="70" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="inter75" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;opacity=70;" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="60" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="desc75" value="&lt;font color=&quot;#CC6600&quot;&gt;&lt;b&gt;AP75 の基準&lt;/b&gt;&lt;/font&gt;" style="text;html=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="510" y="160" width="150" height="20" as="geometry"/>
        </mxCell>

        <!-- IoU = 1.0 -->
        <mxCell id="label100" value="IoU = 1.0" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="680" y="50" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="gt100" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#82b366;opacity=70;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="pred100" value="" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="desc100" value="完全一致" style="text;html=1;fontSize=11;align=center;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="680" y="150" width="120" height="20" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="leg_gt" value="" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="200" y="200" width="16" height="12" as="geometry"/>
        </mxCell>
        <mxCell id="leg_gt_label" value="正解 bbox（Ground Truth）" style="text;html=1;fontSize=12;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="222" y="196" width="180" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg_pred" value="" style="rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="420" y="200" width="16" height="12" as="geometry"/>
        </mxCell>
        <mxCell id="leg_pred_label" value="予測 bbox（Prediction）" style="text;html=1;fontSize=12;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="442" y="196" width="180" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg_inter" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;opacity=70;" vertex="1" parent="1">
          <mxGeometry x="200" y="222" width="16" height="12" as="geometry"/>
        </mxCell>
        <mxCell id="leg_inter_label" value="重なり（Intersection）" style="text;html=1;fontSize=12;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="222" y="218" width="180" height="20" as="geometry"/>
        </mxCell>

        <!-- Formula box -->
        <mxCell id="formula" value="&lt;b&gt;IoU = 重なり面積（Intersection）/ 合計面積（Union）&lt;/b&gt;&lt;br&gt;値が 1.0 に近いほど予測が正確。閾値を超えた検出を「正解」とみなす" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontSize=12;align=center;verticalAlign=middle;spacingTop=4;spacingBottom=4;" vertex="1" parent="1">
          <mxGeometry x="150" y="250" width="500" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
